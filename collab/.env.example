# WitsNote collaboration sidecar

# Port for both the WebSocket endpoint and the /health check.
COLLAB_PORT=1234

# Shared secret used to verify the per-board JWT ticket issued by Laravel.
COLLAB_JWT_SECRET=change-me-to-match-laravel

# Base URL of the Laravel internal API the sidecar calls for ydoc seed/persist.
LARAVEL_INTERNAL_URL=http://localhost:8000/api/internal
# Shared secret authorizing the sidecar -> Laravel internal endpoints.
COLLAB_INTERNAL_SECRET=change-me
