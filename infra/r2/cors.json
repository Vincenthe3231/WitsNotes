{
  "rules": [
    {
      "allowed": {
        "origins": ["http://localhost:3000", "https://app.witsnote.com"],
        "methods": ["GET", "HEAD"],
        "headers": ["Range", "If-None-Match", "If-Modified-Since"]
      },
      "exposeHeaders": ["ETag", "Content-Length", "Content-Range", "Accept-Ranges", "Cache-Control", "Content-Type"],
      "maxAgeSeconds": 3600
    }
  ]
}
